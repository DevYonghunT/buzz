    "agentMessageItemRequired": ["id", "text", "type"],
    "turnStatuses": ["completed", "interrupted", "failed", "inProgress"],
    "sandboxModes": ["read-only", "workspace-write", "danger-full-access"],
    "sessionSources": ["cli", "vscode", "exec", "appServer", "unknown"],
    "stableApprovalDecisions": [
      "accept",
      "acceptForSession",
      "decline",
      "cancel"
    ],
    "permissionGrantScopes": ["turn", "session"]
  }
}
